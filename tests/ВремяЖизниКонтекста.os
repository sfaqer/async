#Использовать asserts
#Использовать "../src"

&Тест
Процедура УспехОсвобождаетКонтекстБезПолученияРезультата() Экспорт

	Обещание = Обещания.ВыполнитьДелегат(Новый Действие(ЭтотОбъект, "ВернутьЧисло"), Новый Массив);
	Дождаться(Обещание);

	ПроверитьОсвобождение(Обещание);
	Утверждения.ПроверитьРавенство(Обещание.Состояние(), СостояниеФоновогоЗадания.Завершено);
	Утверждения.ПроверитьРавенство(Обещание.Получить(), 7);
	Утверждения.ПроверитьРавенство(Обещание.Получить(), 7);

КонецПроцедуры

&Тест
Процедура ИсключениеОсвобождаетКонтекстИСохраняетИсходнуюОшибку() Экспорт

	Обещание = Обещания.ВыполнитьДелегат(Новый Действие(ЭтотОбъект, "ВыброситьОшибку"), Новый Массив);
	Дождаться(Обещание);
	ИсходнаяОшибка = Задание(Обещание).ИнформацияОбОшибке;

	ПроверитьОсвобождение(Обещание);
	Утверждения.ПроверитьРавенство(Обещание.Состояние(), СостояниеФоновогоЗадания.ЗавершеноАварийно);

	Для Повтор = 1 По 2 Цикл
		Попытка
			Обещание.Получить();
			ВызватьИсключение "Ошибка не передана";
		Исключение
			Ошибка = ИнформацияОбОшибке();
			Утверждения.ПроверитьРавенство(Ошибка.Описание, ИсходнаяОшибка.Описание);
			Утверждения.ПроверитьРавенство(Ошибка.Причина.ИмяМодуля, ИсходнаяОшибка.ИмяМодуля);
			Утверждения.ПроверитьРавенство(Ошибка.Причина.НомерСтроки, ИсходнаяОшибка.НомерСтроки);
			Утверждения.ПроверитьИстину(СтрНайти(Ошибка.Причина.ИсходнаяСтрока, "ИсходнаяОшибкаAsync") > 0);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПродолженияДоИПослеУспеха() Экспорт
	ПроверитьПродолжения(Ложь);
КонецПроцедуры

&Тест
Процедура ПродолженияДоИПослеОшибки() Экспорт
	ПроверитьПродолжения(Истина);
КонецПроцедуры

&Тест
Процедура ОшибкаВПродолженииОсвобождаетКонтекст() Экспорт

	Предыдущее = Обещания.ВыполнитьДелегат(Новый Действие(ЭтотОбъект, "ВернутьЧисло"), Новый Массив);
	Продолжение = Предыдущее.Затем(Новый Действие(ЭтотОбъект, "ВыброситьОшибкуПродолжения"));
	Дождаться(Продолжение);

	ПроверитьОсвобождение(Продолжение);
	Ожидаем.Что(Продолжение).Метод("Получить").ВыбрасываетИсключение("ОшибкаПродолжения");
	Утверждения.ПроверитьРавенство(Продолжение.Поймать("Ошибка -> 42").Получить(), 42);

КонецПроцедуры

&Тест
Процедура ОшибкаВПерехватчикеОсвобождаетКонтекст() Экспорт

	Предыдущее = Обещания.ВыполнитьДелегат(Новый Действие(ЭтотОбъект, "ВыброситьОшибку"), Новый Массив);
	Продолжение = Предыдущее.Поймать(Новый Действие(ЭтотОбъект, "ВыброситьОшибкуПерехватчика"));
	Дождаться(Продолжение);

	ПроверитьОсвобождение(Продолжение);
	Ожидаем.Что(Продолжение).Метод("Получить").ВыбрасываетИсключение("ОшибкаПерехватчика");

КонецПроцедуры

&Тест
Процедура ТаймаутНеОсвобождаетРаботающийКонтекст() Экспорт

	Контроль = Новый Структура("Разрешено", Ложь);
	Обещание = СоздатьОжидающее(Контроль, Ложь, Истина);
	ПараметрыТаймаута = Новый Массив;
	ПараметрыТаймаута.Добавить(1);

	Ожидаем.Что(Обещание).Метод("Получить", ПараметрыТаймаута)
		.ВыбрасываетИсключение("Превышено время ожидания получения результата");

	Утверждения.ПроверитьИстину(Контекст(Обещание).Алгоритм() <> Неопределено);
	Утверждения.ПроверитьИстину(Контекст(Обещание).Параметры() <> Неопределено);
	Продолжение = Обещание.Затем("Х -> Х * 2");

	Ожидаем.Что(Продолжение).Метод("Получить", ПараметрыТаймаута)
		.ВыбрасываетИсключение("Превышено время ожидания получения результата");
	Утверждения.ПроверитьРавенство(Контекст(Продолжение).Предыдущий(), Обещание);
	Утверждения.ПроверитьИстину(Контекст(Продолжение).Алгоритм() <> Неопределено);

	Контроль.Разрешено = Истина;

	Утверждения.ПроверитьРавенство(Обещание.Получить(10000), 7);
	Утверждения.ПроверитьРавенство(Обещание.Получить(), 7);
	Утверждения.ПроверитьРавенство(Продолжение.Получить(10000), 14);
	ПроверитьОсвобождение(Обещание);

КонецПроцедуры

&Тест
Процедура ТаймаутОжидатьВсеНеОсвобождаетКонтекст() Экспорт

	Контроль = Новый Структура("Разрешено", Ложь);
	Обещание = СоздатьОжидающее(Контроль, Ложь, Истина);
	ОбещанияДляОжидания = Новый Массив;
	ОбещанияДляОжидания.Добавить(Обещание);

	Попытка
		Обещания.ОжидатьВсе(ОбещанияДляОжидания, 1);
		ВызватьИсключение "Ожидался таймаут";
	Исключение
		Утверждения.ПроверитьИстину(СтрНайти(ОписаниеОшибки(), "Превышено время ожидания") > 0);
	КонецПопытки;

	Утверждения.ПроверитьИстину(Контекст(Обещание).Алгоритм() <> Неопределено);
	Утверждения.ПроверитьИстину(Контекст(Обещание).Параметры() <> Неопределено);
	Контроль.Разрешено = Истина;
	Обещания.ОжидатьВсе(ОбещанияДляОжидания, 10000);

	ПроверитьОсвобождение(Обещание);
	Утверждения.ПроверитьРавенство(Обещание.Получить(), 7);

КонецПроцедуры

&Тест
Процедура ДлительноеСохраняетсяВПродолжениях() Экспорт

	Для ЗначениеФлага = 0 По 1 Цикл
		Контроль = Новый Структура("Разрешено", Ложь);
		Длительное = ЗначениеФлага = 1;
		Обещание = СоздатьОжидающее(Контроль, Ложь, Длительное);
		ДоЗавершения = Обещание.Затем("Х -> Х").Поймать("Ошибка -> 0");

		Утверждения.ПроверитьРавенство(Контекст(Обещание).Длительное(), Длительное);
		Утверждения.ПроверитьРавенство(Контекст(ДоЗавершения).Длительное(), Длительное);
		Контроль.Разрешено = Истина;
		Дождаться(ДоЗавершения);
		ПослеЗавершения = Обещание.Поймать("Ошибка -> 0").Затем("Х -> Х");
		Дождаться(ПослеЗавершения);

		Утверждения.ПроверитьРавенство(Контекст(Обещание).Длительное(), Длительное);
		Утверждения.ПроверитьРавенство(Контекст(ДоЗавершения).Длительное(), Длительное);
		Утверждения.ПроверитьРавенство(Контекст(ПослеЗавершения).Длительное(), Длительное);
		Утверждения.ПроверитьРавенство(ПослеЗавершения.Получить(), 7);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КонкурентноеДобавлениеПродолжений() Экспорт

	Для Итерация = 1 По 8 Цикл
		Контроль = Новый Структура("Разрешено", Ложь);
		СОшибкой = Итерация % 2 = 0;
		Обещание = СоздатьОжидающее(Контроль, СОшибкой, Истина);
		Регистраторы = Новый Массив;
		Параметры = Новый Массив;
		Параметры.Добавить(Обещание);

		Для Индекс = 1 По 4 Цикл
			Регистраторы.Добавить(Обещания.ВыполнитьДелегат(
				Новый Действие(ЭтотОбъект, "ДобавитьПродолжения"), Параметры, Истина));
		КонецЦикла;

		Контроль.Разрешено = Истина;
		Обещания.ОжидатьВсе(Регистраторы, 10000);

		Для Каждого Регистратор Из Регистраторы Цикл
			Продолжения = Регистратор.Получить();
			Обещания.ОжидатьВсе(Продолжения, 10000);

			Для Индекс = 0 По Продолжения.ВГраница() Цикл
				ПроверитьПродолжение(Продолжения[Индекс], СОшибкой, Индекс % 2 = 1);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПродолжения(СОшибкой)

	Контроль = Новый Структура("Разрешено", Ложь);
	Обещание = СоздатьОжидающее(Контроль, СОшибкой, Истина);
	ДоЗавершения = ДобавитьПродолжения(Обещание);
	Утверждения.ПроверитьИстину(Контекст(Обещание).Алгоритм() <> Неопределено);
	Контроль.Разрешено = Истина;
	Обещания.ОжидатьВсе(ДоЗавершения, 10000);
	ПроверитьОсвобождение(Обещание);
	ПослеЗавершения = ДобавитьПродолжения(Обещание);
	Обещания.ОжидатьВсе(ПослеЗавершения, 10000);

	Для Индекс = 0 По ДоЗавершения.ВГраница() Цикл
		ПроверитьПродолжение(ДоЗавершения[Индекс], СОшибкой, Индекс % 2 = 1);
		ПроверитьПродолжение(ПослеЗавершения[Индекс], СОшибкой, Индекс % 2 = 1);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПродолжение(Обещание, СОшибкой, Перехватчик)

	ПроверитьОсвобождение(Обещание);

	Если СОшибкой И Не Перехватчик Тогда
		Ожидаем.Что(Обещание).Метод("Получить").ВыбрасываетИсключение("ИсходнаяОшибкаAsync");
	Иначе
		Ожидаемое = ?(СОшибкой, 42, ?(Перехватчик, 7, 14));
		Утверждения.ПроверитьРавенство(Обещание.Получить(), Ожидаемое);
		Утверждения.ПроверитьРавенство(Обещание.Получить(), Ожидаемое);
	КонецЕсли;

КонецПроцедуры

Функция ДобавитьПродолжения(Обещание) Экспорт

	Результат = Новый Массив;

	Для Индекс = 1 По 4 Цикл
		Результат.Добавить(Обещание.Затем(Новый Действие(ЭтотОбъект, "Удвоить")));
		Результат.Добавить(Обещание.Поймать(Новый Действие(ЭтотОбъект, "ОбработатьОшибку")));
		Приостановить(1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоздатьОжидающее(Контроль, СОшибкой, Длительное)

	Параметры = Новый Массив;
	Параметры.Добавить(Контроль);
	Параметры.Добавить(СОшибкой);

	Возврат Обещания.ВыполнитьДелегат(Новый Действие(ЭтотОбъект, "ДождатьсяРазрешения"), Параметры, Длительное);

КонецФункции

Функция ДождатьсяРазрешения(Контроль, СОшибкой) Экспорт

	Для ПопыткаОжидания = 1 По 10000 Цикл
		Если Контроль.Разрешено Тогда
			Если СОшибкой Тогда
				Возврат ВыброситьОшибку();
			КонецЕсли;
			Возврат 7;
		КонецЕсли;
		Приостановить(1);
	КонецЦикла;

	ВызватьИсключение "Не получено разрешение на завершение";

КонецФункции

Функция ВернутьЧисло() Экспорт
	Возврат 7;
КонецФункции

Функция ВыброситьОшибку() Экспорт
	ВызватьИсключение "ИсходнаяОшибкаAsync";
КонецФункции

Функция Удвоить(Число) Экспорт
	Возврат Число * 2;
КонецФункции

Функция ВыброситьОшибкуПродолжения(Результат) Экспорт
	ВызватьИсключение "ОшибкаПродолжения";
КонецФункции

Функция ВыброситьОшибкуПерехватчика(Ошибка) Экспорт
	ВызватьИсключение "ОшибкаПерехватчика";
КонецФункции

Функция ОбработатьОшибку(Ошибка) Экспорт

	Утверждения.ПроверитьИстину(СтрНайти(Ошибка.Описание, "ИсходнаяОшибкаAsync") > 0, ПодробноеПредставлениеОшибки(Ошибка));

	Возврат 42;

КонецФункции

Процедура Дождаться(Обещание)
	Утверждения.ПроверитьИстину(Задание(Обещание).ОжидатьЗавершения(10000));
КонецПроцедуры

Процедура ПроверитьОсвобождение(Обещание)

	Контекст = Контекст(Обещание);

	Утверждения.ПроверитьРавенство(Контекст.Алгоритм(), Неопределено);
	Утверждения.ПроверитьРавенство(Контекст.Параметры(), Неопределено);
	Утверждения.ПроверитьРавенство(Контекст.Предыдущий(), Неопределено);

КонецПроцедуры

Функция Задание(Обещание)
	Возврат Новый Рефлектор().ПолучитьСвойство(Обещание, "Задание");
КонецФункции

Функция Контекст(Обещание)
	Возврат Новый Рефлектор().ПолучитьСвойство(Обещание, "КонтекстВыполнения");
КонецФункции
